# Reverse Engineering Companion MCP environment contract
# No secret or API key is required. Copy to .env only when overriding defaults.

# The portable companion is intentionally read-only. Other values fail closed.
RE_MCP_MODE=read_only

# Diagnostics go to stderr because stdout is reserved for the MCP protocol.
RE_MCP_LOG_LEVEL=WARNING

# Maximum complete artifact size: 512 MiB.
RE_MCP_MAX_FILE_BYTES=536870912

# Maximum bounded selection/XOR range: 1 MiB.
RE_MCP_MAX_REGION_BYTES=1048576

# Maximum entropy scan or dump-plan range: 64 MiB.
RE_MCP_MAX_SCAN_BYTES=67108864

# Optional authorized sample roots. Empty means no extra root restriction.
# Windows separates multiple roots with ; and macOS/Linux with :
# Windows example: C:\Samples;D:\Authorized-Lab
# macOS/Linux example: /srv/samples:/opt/authorized-lab
RE_MCP_ALLOWED_ROOTS=

# Optional reviewed provider registry JSON. Empty uses PATH/Python module discovery.
RE_MCP_PROVIDER_CONFIG=

# Static provider process timeout and per-stream capture ceiling.
RE_MCP_PROVIDER_TIMEOUT_SECONDS=120
RE_MCP_MAX_PROVIDER_OUTPUT_BYTES=4194304

# Archive metadata audit safety budgets; no extraction is performed.
RE_MCP_MAX_ARCHIVE_MEMBERS=100000
RE_MCP_MAX_ARCHIVE_EXPANDED_BYTES=4294967296
RE_MCP_MAX_ARCHIVE_MEMBER_RATIO=1000
RE_MCP_ARCHIVE_TIMEOUT_SECONDS=30

# Runtime analysis broker configuration (optional; no sample is submitted by
# readiness/env-check. Keep credentials out of source-controlled files.)
# Supported providers: none, mock (test only), cape, drakvuf, vmray, internal
RE_BROKER_PROVIDER=none
# Prefer loopback. Remote endpoints require HTTPS and explicit opt-in below.
RE_BROKER_BASE_URL=
RE_BROKER_ID=
# Optional API token, supplied only by the launching process/secret manager.
RE_BROKER_TOKEN=
# SHA-256 digest of operator-pinned raw Ed25519 public-key bytes (64 hex chars).
RE_BROKER_PUBLIC_KEY=
RE_BROKER_ALLOW_REMOTE_HTTPS=false
# Submission is disabled unless you explicitly enable the gated CAPE task tool.
RE_BROKER_SUBMISSION_ENABLED=false
# Required only when CAPE submission is enabled; operator-attested mappings.
RE_BROKER_CAPE_MACHINE=
RE_BROKER_CAPE_IMAGE_DIGEST=
RE_BROKER_CAPE_SNAPSHOT_ID=
RE_BROKER_CAPE_NETWORK_PROFILE=
