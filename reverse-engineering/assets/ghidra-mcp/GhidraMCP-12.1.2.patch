@@ -104,7 +104,15 @@ public class GhidraMCPPlugin extends Plugin {
             server = null;
         }
 
-        server = HttpServer.create(new InetSocketAddress(port), 0);
+        // The MCP bridge is local-only. Binding to loopback prevents the
+        // unauthenticated analysis/mutation API from being exposed to the LAN.
+        server = HttpServer.create(new InetSocketAddress("127.0.0.1", port), 0);
+
+        server.createContext("/health", exchange -> {
+            Program currentProgram = getCurrentProgram();
+            String program = currentProgram == null ? "none" : currentProgram.getName();
+            sendResponse(exchange, "status=ok\nprogram=" + program + "\n");
+        });
 
