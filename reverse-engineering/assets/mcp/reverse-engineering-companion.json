      "args": [
        "ABSOLUTE_PATH_TO/reverse-engineering/scripts/re_mcp_server.py"
      ],
      "env": {
        "RE_MCP_MODE": "read_only",
        "RE_MCP_LOG_LEVEL": "WARNING",
